SELECT 
    s.ScheduleId AS [ID],
    s.LessonDate AS [Дата],
    lt.LessonNumber AS [Пара №],
    lt.StartTime AS [Начало],
    lt.EndTime AS [Конец],
    g.GroupName AS [Группа],
    sub.SubjectName AS [Предмет],
    t.FullName AS [Преподаватель],
    c.RoomNumber AS [Аудитория]
FROM Schedule s
JOIN StudentGroups g ON s.GroupId = g.GroupId
JOIN Teachers t ON s.TeacherId = t.TeacherId
JOIN Classrooms c ON s.ClassroomId = c.ClassroomId
JOIN Subjects sub ON s.SubjectId = sub.SubjectId
JOIN LessonTimes lt ON s.LessonTimeId = lt.LessonTimeId
ORDER BY s.LessonDate, lt.LessonNumber;
SELECT 
    s.LessonDate AS [Дата],
    lt.LessonNumber AS [Пара №],
    t.FullName AS [Преподаватель],
    sub.SubjectName AS [Предмет],
    c.RoomNumber AS [Аудитория]
FROM Schedule s
JOIN Teachers t ON s.TeacherId = t.TeacherId
JOIN Subjects sub ON s.SubjectId = sub.SubjectId
JOIN Classrooms c ON s.ClassroomId = c.ClassroomId
JOIN LessonTimes lt ON s.LessonTimeId = lt.LessonTimeId
WHERE t.FullName = N'Иванов И.И.';
SELECT 
    t.FullName AS [Преподаватель],
    COUNT(s.ScheduleId) AS [Количество пар]
FROM Teachers t
LEFT JOIN Schedule s ON t.TeacherId = s.TeacherId
GROUP BY t.FullName;
