USE master;
GO
IF EXISTS (SELECT name FROM sys.databases WHERE name = N'UniversitySchedule')
BEGIN
    ALTER DATABASE UniversitySchedule SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
    DROP DATABASE UniversitySchedule;
END
GO
CREATE DATABASE UniversitySchedule;
GO
USE UniversitySchedule;
GO
CREATE TABLE StudentGroups (
    GroupId INT IDENTITY(1,1) PRIMARY KEY,
    GroupName NVARCHAR(50) NOT NULL UNIQUE
);
GO
CREATE TABLE Teachers (
    TeacherId INT IDENTITY(1,1) PRIMARY KEY,
    FullName NVARCHAR(150) NOT NULL,
    Email NVARCHAR(100) UNIQUE
);
GO
CREATE TABLE Classrooms (
    ClassroomId INT IDENTITY(1,1) PRIMARY KEY,
    RoomNumber NVARCHAR(20) NOT NULL UNIQUE,
    Capacity INT NOT NULL CHECK (Capacity > 0)
);
GO
CREATE TABLE Subjects (
    SubjectId INT IDENTITY(1,1) PRIMARY KEY,
    SubjectName NVARCHAR(100) NOT NULL UNIQUE
);
GO
CREATE TABLE LessonTimes (
    LessonTimeId INT IDENTITY(1,1) PRIMARY KEY,
    LessonNumber INT NOT NULL UNIQUE CHECK (LessonNumber BETWEEN 1 AND 8),
    StartTime TIME NOT NULL,
    EndTime TIME NOT NULL
);
GO
CREATE TABLE Schedule (
    ScheduleId INT IDENTITY(1,1) PRIMARY KEY,
    LessonDate DATE NOT NULL,
    LessonTimeId INT NOT NULL,
    GroupId INT NOT NULL,
    TeacherId INT NOT NULL,
    ClassroomId INT NOT NULL,
    SubjectId INT NOT NULL,
    CONSTRAINT FK_Schedule_LessonTimes FOREIGN KEY (LessonTimeId) REFERENCES LessonTimes(LessonTimeId),
    CONSTRAINT FK_Schedule_Groups FOREIGN KEY (GroupId) REFERENCES StudentGroups(GroupId),
    CONSTRAINT FK_Schedule_Teachers FOREIGN KEY (TeacherId) REFERENCES Teachers(TeacherId),
    CONSTRAINT FK_Schedule_Classrooms FOREIGN KEY (ClassroomId) REFERENCES Classrooms(ClassroomId),
    CONSTRAINT FK_Schedule_Subjects FOREIGN KEY (SubjectId) REFERENCES Subjects(SubjectId)
);
GO
CREATE TABLE ScheduleConflicts (
    ConflictId INT IDENTITY(1,1) PRIMARY KEY,
    ConflictDate DATETIME DEFAULT GETDATE(),
    ConflictType NVARCHAR(100) NOT NULL,
    Details NVARCHAR(MAX) NOT NULL
);
GO
CREATE TRIGGER TRG_CheckScheduleConflicts
ON Schedule
FOR INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    IF EXISTS (
        SELECT 1 
        FROM inserted i
        JOIN Schedule s ON i.LessonDate = s.LessonDate 
                       AND i.LessonTimeId = s.LessonTimeId 
                       AND i.GroupId = s.GroupId 
                       AND i.ScheduleId <> s.ScheduleId
    )
    BEGIN
        INSERT INTO ScheduleConflicts (ConflictType, Details)
        SELECT N'Конфликт Группы', 
               N'Группа ID ' + CAST(i.GroupId AS NVARCHAR) + N' уже занята на дату ' + CAST(i.LessonDate AS NVARCHAR)
        FROM inserted i;

        RAISERROR (N'Ошибка: Группа не может иметь две пары одновременно!', 16, 1);
        ROLLBACK TRANSACTION;
        RETURN;
    END
    IF EXISTS (
        SELECT 1 
        FROM inserted i
        JOIN Schedule s ON i.LessonDate = s.LessonDate 
                       AND i.LessonTimeId = s.LessonTimeId 
                       AND i.TeacherId = s.TeacherId 
                       AND i.ScheduleId <> s.ScheduleId
    )
    BEGIN
        INSERT INTO ScheduleConflicts (ConflictType, Details)
        SELECT N'Конфликт Преподавателя', 
               N'Преподаватель ID ' + CAST(i.TeacherId AS NVARCHAR) + N' уже занят на дату ' + CAST(i.LessonDate AS NVARCHAR)
        FROM inserted i;

        RAISERROR (N'Ошибка: Преподаватель не может вести две пары одновременно!', 16, 1);
        ROLLBACK TRANSACTION;
        RETURN;
    END
    IF EXISTS (
        SELECT 1 
        FROM inserted i
        JOIN Schedule s ON i.LessonDate = s.LessonDate 
                       AND i.LessonTimeId = s.LessonTimeId 
                       AND i.ClassroomId = s.ClassroomId 
                       AND i.ScheduleId <> s.ScheduleId
    )
    BEGIN
        INSERT INTO ScheduleConflicts (ConflictType, Details)
        SELECT N'Конфликт Аудитории', 
               N'Аудитория ID ' + CAST(i.ClassroomId AS NVARCHAR) + N' уже занята на дату ' + CAST(i.LessonDate AS NVARCHAR)
        FROM inserted i;
        RAISERROR (N'Ошибка: Аудитория уже занята на эту пару!', 16, 1);
        ROLLBACK TRANSACTION;
        RETURN;
    END
END;
